# Port a adresa, na které server poslouchá.
# 127.0.0.1 = jen lokálně (reverzní proxy / cloudflared na STEJNÉM serveru).
# 0.0.0.0   = i z jiných počítačů v síti – nutné, když cloudflared běží na JINÉM stroji.
#             Pak port 8787 povol ve firewallu jen pro IP toho stroje (viz README).
PORT=8787
HOST=127.0.0.1

# Volitelné heslo k celé aplikaci (přihlašovací stránka, zadává se jen heslo).
# DOPORUČENO nastavit, jakmile je aplikace dostupná z internetu.
APP_PASSWORD=

# Volitelně lze ListenBrainz údaje zadat i tady (jinak se zadají v aplikaci)
LB_USER=
LB_TOKEN=

# AI moderátor: klíč z https://openrouter.ai/keys (jde zadat i v aplikaci)
OPENROUTER_API_KEY=

# Cesta k yt-dlp (výchozí: yt-dlp z PATH)
YTDLP_BIN=yt-dlp

# Když YouTube na serveru hlásí „Sign in to confirm you're not a bot“ nebo 429:
# cookies z přihlášeného prohlížeče (formát Netscape, soubor musí být zapisovatelný uživatelem radio, tedy v data/).
# Viz README, sekce „Hudba se nepřehrává“.
YTDLP_COOKIES=
# 0 = nevynucovat IPv4 (výchozí: yt-dlp používá jen IPv4, YouTube je k IPv6 přísnější)
YTDLP_IPV4=1
# 0 = nepřidávat klienta web_embedded (pomáhá proti bot kontrole YouTube i bez přihlášení)
YTDLP_EMBEDDED=1
# Další argumenty yt-dlp (volitelné), např. --extractor-args youtube:player_client=tv
YTDLP_ARGS=
# 0 = nestahovat řešení výzev YouTube z GitHubu (yt-dlp-ejs); výchozí je povoleno
YTDLP_REMOTE_EJS=1
